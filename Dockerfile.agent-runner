FROM golang:1.25-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN go test ./cmd/agent-runner-cli-launcher -count=1 \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/agent-runner ./cmd/agent-runner \
    && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/agent-runner-cli-launcher ./cmd/agent-runner-cli-launcher

FROM alpine:3.24

ARG GOPROXY=https://proxy.golang.org,direct

RUN apk add --no-cache tzdata ca-certificates bash git curl unzip xz jq procps python3 py3-pip su-exec gcompat libcap-utils \
    'nodejs~24' npm 'pnpm~11' openjdk8 openjdk17-jdk openjdk21-jdk 'maven~3.9' \
    && git config --system --add safe.directory "*" \
    && adduser -D -u 10001 -s /bin/bash runner \
    && addgroup -S -g 10002 agent \
    && adduser -D -H -u 10002 -G agent -s /sbin/nologin agent

WORKDIR /app

COPY --from=builder /out/agent-runner /app/agent-runner
COPY --from=builder /out/agent-runner-cli-launcher /usr/local/bin/agent-runner-cli-launcher
COPY --from=builder /usr/local/go /usr/local/go
COPY deploy/agent-runner-entrypoint.sh /usr/local/bin/agent-runner-entrypoint
COPY deploy/agent-runner-runtime /opt/vendor
COPY deploy/agent-runner-maven-settings.xml /usr/share/java/maven-3/conf/settings.xml
COPY deploy/tests/runner-toolchains.sh /usr/local/bin/check-runner-toolchains

ENV TZ=Asia/Shanghai \
    SHELL=/bin/bash \
    JAVA8_HOME=/usr/lib/jvm/java-1.8-openjdk \
    JAVA17_HOME=/usr/lib/jvm/java-17-openjdk \
    JAVA21_HOME=/usr/lib/jvm/java-21-openjdk \
    JAVA_HOME=/usr/lib/jvm/java-21-openjdk \
    PATH=/usr/local/go/bin:/opt/codex/bin:/opt/claude/bin:/usr/lib/jvm/java-21-openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    MAVEN_OPTS="-Daether.syncContext.named.factory=file-lock -Daether.syncContext.named.nameMapper=file-gav" \
    AGENT_RUNNER_HTTP_ADDR=:8081 \
    AGENT_RUNNER_DATA_ROOT=/app/runner-data \
    AGENT_RUNNER_WORKSPACE_ROOT=/app/workspaces \
    AGENT_RUNNER_CACHE_ROOT=/app/dependency-cache \
    AGENT_RUNNER_CLI_LAUNCHER=/usr/local/bin/agent-runner-cli-launcher \
    AGENT_RUNNER_CODEX_BINARY=/opt/codex/bin/codex \
    AGENT_RUNNER_LOG_DIR=/app/logs/agent-runner \
    GOPROXY=${GOPROXY} \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1

RUN sed -i '1i agent_runner_original_path=$PATH' /etc/profile \
    && printf '\n%s\n' 'export PATH="$agent_runner_original_path"' 'unset agent_runner_original_path' >> /etc/profile \
    && ln -s /usr/local/go/bin/go /usr/local/bin/go \
    && ln -s /usr/local/go/bin/gofmt /usr/local/bin/gofmt

RUN chmod 0755 /app/agent-runner /usr/local/bin/agent-runner-entrypoint /usr/local/bin/check-runner-toolchains /opt/vendor/materialize.sh \
    && /opt/vendor/materialize.sh /opt/vendor \
    && rm -rf /opt/vendor \
    && chown root:runner /usr/local/bin/agent-runner-cli-launcher \
    && chmod 0750 /usr/local/bin/agent-runner-cli-launcher \
    && setcap cap_chown,cap_dac_override,cap_kill,cap_setgid,cap_setuid=ep /usr/local/bin/agent-runner-cli-launcher \
    && getcap /usr/local/bin/agent-runner-cli-launcher | grep -q cap_chown \
    && getcap /usr/local/bin/agent-runner-cli-launcher | grep -q cap_dac_override \
    && getcap /usr/local/bin/agent-runner-cli-launcher | grep -q cap_kill \
    && getcap /usr/local/bin/agent-runner-cli-launcher | grep -q cap_setgid \
    && getcap /usr/local/bin/agent-runner-cli-launcher | grep -q cap_setuid \
    && mkdir -p /app/runner-data /app/workspaces /app/logs/agent-runner \
    && chown runner:runner /app/runner-data /app/workspaces /app/logs/agent-runner \
    && mkdir -p /app/dependency-cache \
    && chown agent:agent /app/dependency-cache \
    && chmod 0700 /app/dependency-cache \
    && test -x /opt/codex/bin/codex \
    && command -v su-exec \
    && /opt/codex/bin/codex --version \
    && git --version \
    && go version \
    && for shell in /bin/sh /bin/bash; do \
         for mode in -c -lc; do \
           su-exec runner "$shell" "$mode" 'command -v go && command -v gofmt && command -v codex && go version && test "$(go env GOROOT)" = /usr/local/go' || exit 1; \
         done; \
         su-exec runner env PATH="/agent-runner-path-check:$PATH" AGENT_RUNNER_EXPECTED_PATH="/agent-runner-path-check:$PATH" "$shell" -lc 'test "$PATH" = "$AGENT_RUNNER_EXPECTED_PATH"' || exit 1; \
       done \
    && su-exec runner env PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin /bin/sh -c 'go version && gofmt -h && test "$(go env GOROOT)" = /usr/local/go' \
    && python3 --version \
    && pip3 --version \
    && bash --version \
    && su-exec runner /bin/true \
    && su-exec runner /usr/local/bin/agent-runner-cli-launcher --check \
    && su-exec agent /bin/sh -c '! test -x /usr/local/bin/agent-runner-cli-launcher' \
    && if [ -x /opt/claude/bin/claude ]; then /opt/claude/bin/claude --version || echo "WARNING: claude present but failed to run"; else echo "claude: not vendored, skipped"; fi \
    && toolcheck_home=$(mktemp -d) \
    && chown agent:agent "$toolcheck_home" \
    && su-exec agent env HOME="$toolcheck_home" /usr/local/bin/check-runner-toolchains \
    && rm -rf "$toolcheck_home"

EXPOSE 8081

ENTRYPOINT ["agent-runner-entrypoint"]
CMD ["/app/agent-runner"]
