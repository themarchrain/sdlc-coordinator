FROM golang:1.25-alpine AS builder

ARG GOPROXY=https://proxy.golang.org,direct

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/agent-runner ./cmd/agent-runner

FROM buildpack-deps:bookworm-scm

# scm 已带 bash、curl、wget、ca-certificates、git、openssh-client、tar、gzip、procps。
# 这里只补投放包解压和入口降权还需要的几样。
# Override for a regional Debian mirror, for example:
#   --build-arg DEBIAN_MIRROR=https://mirrors.aliyun.com
# Official Debian: leave DEBIAN_MIRROR empty (default).
ARG DEBIAN_MIRROR=

RUN set -eux; \
    if [ -n "${DEBIAN_MIRROR}" ]; then \
      find /etc/apt -type f \( -name '*.list' -o -name '*.sources' \) \
        -exec sed -i \
          -e "s#http://deb.debian.org#${DEBIAN_MIRROR}#g" \
          -e "s#https://deb.debian.org#${DEBIAN_MIRROR}#g" \
          -e "s#http://security.debian.org#${DEBIAN_MIRROR}#g" \
          -e "s#https://security.debian.org#${DEBIAN_MIRROR}#g" \
          {} +; \
    fi; \
    apt-get update \
    && apt-get install -y --no-install-recommends gosu tzdata unzip xz-utils \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /bin/bash runner

WORKDIR /app

COPY --from=builder /out/agent-runner /app/agent-runner
COPY deploy/agent-runner-entrypoint.sh /usr/local/bin/agent-runner-entrypoint
COPY deploy/agent-runner-runtime /opt/vendor

# PATH 必须在校验 RUN 之前生效：npm/mvn 是脚本，靠 `env node` / JAVA_HOME 找工具。
ENV TZ=Asia/Shanghai \
    SHELL=/bin/bash \
    JAVA_HOME=/opt/jdk \
    PATH=/opt/codex/bin:/opt/node/bin:/opt/jdk/bin:/opt/maven/bin:/opt/python/bin:/opt/claude/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    AGENT_RUNNER_HTTP_ADDR=:8081 \
    AGENT_RUNNER_DATA_ROOT=/app/runner-data \
    AGENT_RUNNER_CODEX_BINARY=/opt/codex/bin/codex \
    DISABLE_AUTOUPDATER=1 \
    DISABLE_TELEMETRY=1 \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

RUN chmod 0755 /app/agent-runner /usr/local/bin/agent-runner-entrypoint /opt/vendor/materialize.sh \
    && /opt/vendor/materialize.sh /opt/vendor \
    && rm -rf /opt/vendor \
    && mkdir -p /app/runner-data /app/workspaces \
    && chown runner:runner /app/runner-data /app/workspaces \
    && test -x /opt/codex/bin/codex \
    && test -x /opt/node/bin/node \
    && test -x /opt/jdk/bin/java \
    && test -x /opt/jdk/bin/javac \
    && test -x /opt/python/bin/python3 \
    && test -x /opt/maven/bin/mvn \
    && /opt/codex/bin/codex --version \
    && /opt/node/bin/node -v | grep -q '^v22' \
    && /opt/node/bin/npm -v \
    && /opt/jdk/bin/java -version \
    && /opt/jdk/bin/javac -version \
    && /opt/python/bin/python3 --version | grep -q '3\.12' \
    && /opt/maven/bin/mvn -version \
    && bash --version \
    && git --version \
    && test -x /usr/sbin/gosu \
    && gosu --version

EXPOSE 8081

ENTRYPOINT ["agent-runner-entrypoint"]
CMD ["/app/agent-runner"]
